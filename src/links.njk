---
layout: layouts/base.njk
permalink: /links/
bare: true
accent: lavender
title: "Raven Whitley | RaeAligned Strategic Services"
description: "Book a consultation or a notary signing with Raven Whitley, founder of RaeAligned Strategic Services in Raleigh–Durham, NC."
---
{#- Link-in-bio page. Links are edited in src/_data/links.json. -#}
<div class="links-page">
  <header class="lp-head">
    <picture class="lp-photo">
      <source srcset="/assets/img/raven-200.webp 1x, /assets/img/raven-400.webp 2x" type="image/webp">
      <img src="/assets/img/raven-200.jpg" srcset="/assets/img/raven-400.jpg 2x" alt="Raven Whitley" width="120" height="120">
    </picture>
    <h1>Raven Whitley</h1>
    <p class="lp-role">Founder, RaeAligned Strategic Services</p>
    <p class="lp-tag">Helping people and small businesses move important work forward.</p>
    <nav class="lp-social" aria-label="Social and email">
      <a href="{{ site.instagramUrl }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/></svg>
        <span>Instagram</span>
      </a>
      <a href="mailto:{{ site.email }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.8 7l8.2 6 8.2-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        <span>Email</span>
      </a>
    </nav>
  </header>

  <section class="lp-primary" aria-label="Book">
    {%- for l in links.primary %}
    {%- set href = site.booking.consulting.url if l.url == "BOOKING_CONSULTING" else l.url %}
    <a class="lp-big lp-{{ l.style }}" href="{{ href }}"{% if href.startsWith("http") %} target="_blank" rel="noopener"{% endif %}>
      <span class="lp-big-label">{{ l.label }}</span>
      <span class="lp-big-note">{{ l.note }}</span>
      <span class="lp-arrow" aria-hidden="true">→</span>
    </a>
    {%- endfor %}
  </section>

  <section class="lp-more" aria-labelledby="lp-more-h">
    <h2 id="lp-more-h">More from RaeAligned</h2>
    <ul>
      {%- for l in links.more %}
      <li><a href="{{ l.url }}"{% if l.url.startsWith("http") %} target="_blank" rel="noopener"{% endif %}><span><b>{{ l.label }}</b><small>{{ l.note }}</small></span><span class="lp-arrow" aria-hidden="true">→</span></a></li>
      {%- endfor %}
    </ul>
  </section>

  <footer class="lp-foot">
    <img src="/assets/logos/raealigned-icon-only.svg" alt="" width="516" height="406">
    <a href="/">raealignedservices.com</a>
    <p>{{ site.notaryDisclaimer }}</p>
    <p>{{ site.legalLine }}</p>
  </footer>
</div>
