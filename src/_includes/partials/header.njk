{%- set nav = [
  { url: "/", label: "Home" },
  { url: "/about/", label: "About" },
  { url: "/services/", label: "Services" },
  { url: "/notary/", label: "Notary" },
  { url: "/contact/", label: "Contact" }
] -%}
<header class="site-header">
  <div class="wrap header-in">
    <a class="logo" href="/" aria-label="{{ site.name }}, home">
      <img class="logo-full" src="/assets/logos/raealigned-horizontal.svg" alt="" width="868" height="300">
      <img class="logo-mark" src="/assets/logos/raealigned-icon-only.svg" alt="" width="516" height="406">
    </a>
    <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="siteNav">
      <span class="sr-only">Menu</span>
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="4" y1="9" x2="22" y2="9"/><line x1="8" y1="17" x2="22" y2="17"/></g></svg>
    </button>
    <nav class="site-nav" id="siteNav" aria-label="Main" data-open="false">
      {%- for item in nav %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
      {%- if accent == "orchid" %}
      <a class="btn btn-dark btn-sm" href="#book">Book a signing</a>
      {%- else %}
      <a class="btn btn-dark btn-sm" href="{{ site.booking.consulting.url }}" target="_blank" rel="noopener">Book a call</a>
      {%- endif %}
    </nav>
  </div>
</header>
