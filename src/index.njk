---
layout: layouts/base.njk
permalink: /
bare: true
accent: lavender
title: "RaeAligned Strategic Services | Strategy, Projects & Notary — Raleigh–Durham"
description: "Raven Whitley helps individuals and small businesses turn ideas into clear plans, practical systems, and finished work. Book a consultation or a mobile notary signing in Raleigh–Durham."
schema:
  "@context": "https://schema.org"
  "@type": ProfessionalService
  "@id": "https://raealignedservices.com/#business"
  name: RaeAligned Strategic Services
  url: "https://raealignedservices.com/"
  email: raven@raealignedservices.com
  logo: "https://raealignedservices.com/favicon-512x512.png"
  image: "https://raealignedservices.com/favicon-512x512.png"
  description: "Strategy, project management, AI enablement, planning and coordination, systems, and mobile notary services for individuals and small businesses."
  founder: { "@type": Person, name: Raven Whitley, jobTitle: "Founder & Principal Strategist" }
  areaServed:
    - { "@type": City, name: "Raleigh, NC" }
    - { "@type": City, name: "Durham, NC" }
    - { "@type": City, name: "Cary, NC" }
    - { "@type": City, name: "Chapel Hill, NC" }
    - { "@type": City, name: "Apex, NC" }
    - { "@type": City, name: "Morrisville, NC" }
  sameAs: ["https://www.instagram.com/raealigned.services/", "https://www.facebook.com/1437150769475449"]
---
{#- Homepage (link-in-bio style). Links are edited in src/_data/links.json. -#}
<div class="links-page">
  <header class="lp-head">
    <picture class="lp-photo">
      <source srcset="/assets/img/raven-200.webp 1x, /assets/img/raven-400.webp 2x" type="image/webp">
      <img src="/assets/img/raven-200.jpg" srcset="/assets/img/raven-400.jpg 2x" alt="Raven Whitley" width="120" height="120">
    </picture>
    <h1>Raven Whitley</h1>
    <p class="lp-role">Founder, RaeAligned Strategic Services</p>
    <p class="lp-tag">Helping people and small businesses move important work forward.</p>
    <nav class="lp-social" aria-label="Social and email">
      <a href="{{ site.instagramUrl }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/></svg>
        <span>Instagram</span>
      </a>
      <a href="{{ site.facebookUrl }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8.5" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 19c.6-3.3 2.8-5.2 5.5-5.2s4.9 1.9 5.5 5.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="16.5" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15.8 14.1c2.4-.3 4.3 1.3 4.8 4.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span>Facebook</span>
      </a>
      <a href="mailto:{{ site.email }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.8 7l8.2 6 8.2-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        <span>Email</span>
      </a>
    </nav>
  </header>

  <section class="lp-primary" aria-label="Book">
    {%- for l in links.primary %}
    {%- set href = site.booking.consulting.url if l.url == "BOOKING_CONSULTING" else l.url %}
    <a class="lp-big lp-{{ l.style }}" href="{{ href }}"{% if l.modal %} data-modal="{{ l.modal }}"{% endif %}{% if href.startsWith("http") %} target="_blank" rel="noopener"{% endif %}>
      <span class="lp-big-label">{{ l.label }}</span>
      <span class="lp-big-note">{{ l.note }}</span>
      <span class="lp-arrow" aria-hidden="true">→</span>
    </a>
    {%- endfor %}
  </section>

  <section class="lp-more" aria-labelledby="lp-more-h">
    <h2 id="lp-more-h">More from RaeAligned</h2>
    <ul>
      {%- for l in links.more %}
      <li><a href="{{ l.url }}"{% if l.modal %} data-modal="{{ l.modal }}"{% endif %}{% if l.url.startsWith("http") %} target="_blank" rel="noopener"{% endif %}><span><b>{{ l.label }}</b><small>{{ l.note }}</small></span><span class="lp-arrow" aria-hidden="true">→</span></a></li>
      {%- endfor %}
    </ul>
  </section>

  {% include "partials/mini-footer.njk" %}
</div>

{%- set panels = [
  { id: "services", title: "What I help with" },
  { id: "notary", title: "Notary & signing" },
  { id: "about", title: "Hi, I'm Raven" },
  { id: "contact", title: "Let's talk" },
  { id: "privacy", title: "Privacy policy" }
] %}
{%- for p in panels %}
<dialog class="modal{% if p.id == 'notary' %} theme-orchid{% endif %}" id="m-{{ p.id }}" aria-labelledby="m-{{ p.id }}-h">
  <div class="modal-card">
    <header class="modal-head">
      <h2 id="m-{{ p.id }}-h">{{ p.title }}</h2>
      <button class="modal-close" type="button" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </header>
    <div class="modal-body">
      {% include "content/" + p.id + ".njk" %}
    </div>
  </div>
</dialog>
{%- endfor %}
